# Configuration du déploiement GeBook en staging (docker-compose.staging.yml),
# sur un serveur classique — copier vers `.env` à la racine, à côté de
# docker-compose.staging.yml.
#
# Reprend la structure de .env.docker.example (prod/Dokploy) ; voir ce fichier
# pour le détail de chaque section. Ne sont documentées ici que les variables
# propres au staging.

# ---------------------------------------------------------------------------
# Domaines et TLS
# ---------------------------------------------------------------------------
# Sans le schéma. Les deux doivent pointer (enregistrement A) vers ce serveur
# avant le premier démarrage, sinon Caddy ne peut pas délivrer les
# certificats Let's Encrypt.
STAGING_FRONTEND_DOMAIN=staging.gebook.exemple.com
STAGING_BACKEND_DOMAIN=api-staging.gebook.exemple.com

# Adresse de contact du compte Let's Encrypt (notifications d'expiration de
# certificat uniquement — jamais utilisée à d'autres fins).
ACME_EMAIL=

# ---------------------------------------------------------------------------
# Base de données
# ---------------------------------------------------------------------------
POSTGRES_USER=gebook_admin
POSTGRES_PASSWORD=
POSTGRES_DB=gebook_db
APP_DB_USER=gebook_user
APP_DB_PASSWORD=
RUN_SEED=true

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
# 32 caractères minimum chacun — openssl rand -base64 48 / openssl rand -hex 32.
# Peuvent être identiques à ceux de la prod ou dédiés au staging ; jamais les
# valeurs par défaut du dépôt (le démarrage les refuse).
PAYMENT_WEBHOOK_SECRET=
SETUP_TOKEN=
CREDENTIALS_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Plateforme de paiement
# ---------------------------------------------------------------------------
# PAYMENT_ENV n'est PAS surchargeable ici : docker-compose.staging.yml le
# force à « sandbox » quoi qu'il arrive — le staging ne doit jamais pouvoir
# encaisser un paiement réel.
PAYIN_PROVIDER=fake
PAYOUT_PROVIDER=fake
PAWAPAY_API_URL=
PAWAPAY_API_TOKEN=
CINETPAY_API_URL=
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
CINETPAY_SECRET_KEY=
FEEXPAY_API_URL=
FEEXPAY_API_KEY=
FEEXPAY_SHOP_ID=

# ---------------------------------------------------------------------------
# Stockage des fichiers (Cloudflare R2, par défaut)
# ---------------------------------------------------------------------------
# Un bucket dédié « staging », distinct de celui de la prod, est recommandé :
# guide complet docs/STORAGE_R2_SETUP.md.
STORAGE_DRIVER=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# ---------------------------------------------------------------------------
# Envoi d'e-mails (SMTP du domaine propre)
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# ---------------------------------------------------------------------------
# CAPTCHA (Cloudflare Turnstile)
# ---------------------------------------------------------------------------
# Un site Turnstile dédié au staging est recommandé (domaine différent de la
# prod). Obligatoires toutes les deux — voir .env.docker.example.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---------------------------------------------------------------------------
# Réseau interne
# ---------------------------------------------------------------------------
INTERNAL_API_URL=http://backend:3001
