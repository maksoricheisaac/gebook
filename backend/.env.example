# Configuration de l'API GeBook.
#
# Copier ce fichier vers `.env` puis adapter les valeurs. Le fichier `.env` ne doit
# jamais être versionné : il contient des secrets propres à chaque environnement.
#
# Toutes ces variables sont validées au démarrage. Une valeur manquante ou invalide
# empêche l'API de démarrer, plutôt que de la laisser tourner à moitié configurée.

# development | test | production
NODE_ENV=development

# Port d'écoute de l'API. Le frontend Next.js occupe 3000 en développement.
PORT=3001

DATABASE_URL="postgresql://utilisateur:mot_de_passe@localhost:5432/gebook_db?schema=public"

# Origines autorisées à appeler l'API, séparées par des virgules.
# Jamais `*` : les requêtes portent le cookie de session.
CORS_ORIGINS=http://localhost:3000

# Traces détaillées. Le démarrage est refusé si cette valeur est vraie
# alors que NODE_ENV vaut « production ».
APP_DEBUG=true

# Secret de signature des notifications de paiement (32 caractères minimum).
# Ne vit que dans l'environnement : jamais en base, jamais dans Git.
# Laissée vide, une valeur de développement s'applique — et le démarrage en
# production est alors refusé.
PAYMENT_WEBHOOK_SECRET=

# Jeton exigé par l'assistant de configuration initiale (POST /setup/superadmin)
# pour créer le tout premier compte superadmin de la plateforme (32 caractères
# minimum). Généré une seule fois, communiqué à la personne qui fait la
# configuration initiale, puis retiré — il n'a plus d'usage une fois le
# superadmin créé. Même traitement que PAYMENT_WEBHOOK_SECRET : jamais en base,
# jamais dans Git, et le démarrage en production est refusé tant qu'il garde sa
# valeur de développement.
SETUP_TOKEN=

# Clé de chiffrement des identifiants de prestataire de paiement enregistrés
# depuis le Superadmin (Configurer un prestataire). 32 octets en hexadécimal —
# générer avec `openssl rand -hex 32`. Laissée vide, une valeur de
# développement s'applique — et le démarrage en production est alors refusé.
CREDENTIALS_ENCRYPTION_KEY=

# --- Plateforme de paiement (Phase 1) --------------------------------------
# sandbox | production. Indépendant de NODE_ENV : rester en sandbox tant que
# les identifiants réels des prestataires ne sont pas fournis.
PAYMENT_ENV=sandbox

# Code payment_providers.code du pilote pay-in/payout par défaut (ex. "fake"
# tant qu'aucun compte marchand réel n'est configuré ; "pawapay"/"cinetpay"/
# "feexpay" une fois leurs identifiants sandbox renseignés ci-dessous).
PAYIN_PROVIDER=fake
PAYOUT_PROVIDER=fake

# Toutes optionnelles : un prestataire sans identifiants reste simplement
# indisponible (503), le démarrage n'est jamais bloqué. Ne jamais commiter de
# valeur réelle ici — ce fichier est celui qui EST versionné.
PAWAPAY_API_URL=
PAWAPAY_API_TOKEN=
CINETPAY_API_URL=
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
# Distincte de CINETPAY_API_KEY : sert uniquement à vérifier le X-TOKEN HMAC
# des notifications (Superadmin CinetPay → Intégrations → Clé secrète).
CINETPAY_SECRET_KEY=
FEEXPAY_API_URL=
FEEXPAY_API_KEY=
# Menu Développeurs FeexPay, distinct de FEEXPAY_API_KEY.
FEEXPAY_SHOP_ID=

# URL publique de CETTE API (pas celle du frontend), utilisée pour construire
# les notify_url que certains prestataires (CinetPay) exigent explicitement.
# En développement local, un prestataire réel ne pourra pas atteindre
# localhost : un tunnel (ex. ngrok) est nécessaire pour tester les webhooks
# de bout en bout.
API_PUBLIC_URL=http://localhost:3001

# URL publique du frontend, pour construire les liens envoyés par e-mail
# (vérification d'adresse...). À défaut, le premier CORS_ORIGINS sert de repli.
APP_PUBLIC_URL=http://localhost:3000

# --- Scan antivirus (ClamAV) ------------------------------------------------
# Optionnelles, mais sans elles TOUT téléversement (couverture, photo
# d'auteur, ouvrage numérique) est refusé (503) — jamais un scan
# silencieusement ignoré. Pour tester un téléversement en local sans lancer
# toute la pile Docker :
#   docker run -d -p 3310:3310 --name gebook-clamav clamav/clamav:stable
# (le tout premier démarrage télécharge la base de signatures, prévoir
# plusieurs minutes avant que le port réponde).
CLAMAV_HOST=
CLAMAV_PORT=

# --- Stockage des fichiers ---------------------------------------------------
# local (par défaut, disque) | r2 (Cloudflare R2). Guide complet de
# configuration côté Cloudflare : docs/STORAGE_R2_SETUP.md.
STORAGE_DRIVER=local

# Toutes obligatoires si STORAGE_DRIVER=r2 (le démarrage est alors refusé sans
# elles — voir validateEnvironment()) ; sans objet si STORAGE_DRIVER=local.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Un seul bucket suffit : GeBook y range lui-même ses fichiers publics et
# privés sous deux préfixes distincts (public/ et private/) — jamais besoin
# d'activer un accès public sur ce bucket côté Cloudflare.
R2_BUCKET=

# --- Envoi d'e-mails (SMTP du domaine propre) --------------------------------
# Optionnelles, mais sans elles la vérification d'adresse à l'inscription et
# le code de connexion ne peuvent pas être envoyés : les routes concernées
# répondent alors 503 plutôt que de créer un compte impossible à vérifier.
SMTP_HOST=
# 465 (TLS implicite) ou 587 (STARTTLS) selon l'hébergeur de la boîte mail.
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
# En pratique la même boîte que SMTP_USER. Format libre :
# "GeBook <contact@votre-domaine.com>".
MAIL_FROM=
# Boîte qui reçoit les messages du formulaire de contact public. Optionnelle :
# à défaut, MAIL_FROM sert de repli.
CONTACT_RECIPIENT_EMAIL=

# --- CAPTCHA (Cloudflare Turnstile) ------------------------------------------
# Obligatoire à l'inscription et à la connexion. Le jeton envoyé par le
# widget frontend est toujours revérifié ici, côté serveur, auprès de
# Cloudflare — sans TURNSTILE_SECRET_KEY, ces deux routes refusent toute
# tentative (503) plutôt que de laisser passer sans contrôle.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
