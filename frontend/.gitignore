# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Le modèle de configuration doit rester versionné.
!.env.example

# Valeurs par défaut de développement (non sensibles, communes à toute
# machine locale) : Next.js les charge nativement pour `next dev`, avant
# `.env.local` (toujours prioritaire, pour une éventuelle surcharge
# personnelle) — voir frontend/.env.development.
!.env.development
