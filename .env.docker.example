# Configuration du déploiement GeBook sur Dokploy.
#
# Ces variables se renseignent dans Dokploy, onglet « Environment » de
# l'application. En local, les copier dans un fichier `.env` à la racine.

# ---------------------------------------------------------------------------
# Domaines
# ---------------------------------------------------------------------------
# Sans le schéma : Traefik attend un nom d'hôte nu dans la règle `Host(...)`.
# Les deux doivent pointer (enregistrement A) vers le serveur Dokploy avant le
# premier déploiement, sinon Let's Encrypt ne peut pas délivrer le certificat.
FRONTEND_DOMAIN=gebook.exemple.com
BACKEND_DOMAIN=api.gebook.exemple.com

# ---------------------------------------------------------------------------
# Base de données
# ---------------------------------------------------------------------------
# Superuser d'administration PostgreSQL. L'application ne l'utilise jamais.
POSTGRES_USER=gebook_admin
POSTGRES_PASSWORD=
POSTGRES_DB=gebook_db

# Rôle applicatif, créé sans SUPERUSER ni BYPASSRLS. C'est lui qui fait tenir
# l'isolation multi-tenant : voir docker/postgres/init/01-app-role.sh.
APP_DB_USER=gebook_user
APP_DB_PASSWORD=

# DATABASE_URL n'est PAS à renseigner : le compose l'assemble depuis APP_DB_USER,
# APP_DB_PASSWORD et POSTGRES_DB ci-dessus, pour que le mot de passe ne s'écrive
# qu'une fois.
#
# Ne la définir que dans deux cas :
#   - le mot de passe contient un caractère à encoder (@ : / ? #) — l'encoder
#     alors en pourcentage dans l'URL ;
#   - la base est hébergée ailleurs que dans ce compose.
# DATABASE_URL=postgresql://gebook_user:MOT_DE_PASSE@hote:5432/gebook_db?schema=public

# Données de référence, jouées après les migrations à chaque déploiement.
# Les laisser à « true » au premier déploiement : c'est le seed qui crée la ligne
# `admin` de la table `roles`, sans laquelle la création du superadmin échoue sur
# « Le rôle administrateur est absent de la base de données ». Le seed est
# idempotent, le rejouer ne duplique rien.
#
# À passer à « false » une fois le catalogue réel géré depuis le back-office :
# le seed réinsère sinon le catalogue initial, y compris des œuvres supprimées
# à la main.
RUN_SEED=true

# Le seed s'exécute sous POSTGRES_USER et non sous le rôle applicatif : il écrit
# dans des tables sous RLS sans ouvrir de contexte `app.*`, ce que les policies
# rejetteraient. Cette connexion ne sert qu'au conteneur éphémère de migration,
# jamais à l'API. Rien à renseigner — assemblée depuis POSTGRES_USER,
# POSTGRES_PASSWORD et POSTGRES_DB.
# ADMIN_DATABASE_URL=postgresql://gebook_admin:MOT_DE_PASSE@hote:5432/gebook_db?schema=public

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
# Origine publique du frontend, schéma compris, sans barre finale. Jamais `*` :
# les requêtes portent le cookie de session. Doit correspondre exactement à
# FRONTEND_DOMAIN, préfixé de https:// — `OriginGuard` compare la chaîne entière.
CORS_ORIGINS=https://gebook.exemple.com

# 32 caractères minimum chacun. Le démarrage en production est refusé tant que
# ces valeurs restent celles du dépôt.
#   openssl rand -base64 48
PAYMENT_WEBHOOK_SECRET=
SETUP_TOKEN=

# ---------------------------------------------------------------------------
# Réseau interne
# ---------------------------------------------------------------------------
# Adresse de l'API vue depuis le serveur Next.js, figée dans l'image au build.
# Le nom du service Docker convient : le navigateur ne s'en sert jamais, et le
# trafic serveur-à-serveur reste sur le réseau interne.
#
# À remplacer par https://api.gebook.exemple.com uniquement si Dokploy déploie
# le frontend et l'API comme deux applications distinctes, sans réseau commun.
INTERNAL_API_URL=http://backend:3001

# Ports publiés — utilisés seulement par docker-compose.local.yml, jamais sur
# Dokploy où Traefik joint les conteneurs par le réseau interne.
FRONTEND_PORT=3000
BACKEND_PORT=3001
